disp("--- Ejemplo 7: A*B ---");
A=[1,2,3;4,5,6];
B=[1;1;2];
disp("A="); disp(A);
disp("B="); disp(B);
disp("A*B="); disp(A*B);

disp("--- Ejemplo 9: A.*A ---");
disp(A.*A);

disp("--- Ejemplo 10: 2*(A+2) ---");
disp(2*(A+2));

disp("--- Ejemplo 11: A/A ---");
disp(A/A);

disp("--- Ejemplo 12: A./A ---");
disp(A./A);

disp("--- Ejemplo 13: C*C y C.*C ---");
C=1:4;
disp("C="); disp(C);
disp("C.*C="); disp(C.*C);

disp("--- Ejemplo 14: 1/C ---");
disp(1/C);

disp("--- Ejemplo 15: (1)./C ---");
disp((1)./C);
